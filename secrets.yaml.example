# Copy to secrets.local.yaml and replace every placeholder before applying.
# Keep this example free of real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: growthos
type: Opaque
stringData:
  POSTGRES_USER: REPLACE_WITH_DATABASE_USER
  POSTGRES_PASSWORD: REPLACE_WITH_DATABASE_PASSWORD
  POSTGRES_DB: REPLACE_WITH_DATABASE_NAME
  DATABASE_URL: "postgresql://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/REPLACE_WITH_DATABASE_NAME"
---
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secrets
  namespace: growthos
type: Opaque
stringData:
  JWT_ACCESS_SECRET: REPLACE_WITH_RANDOM_ACCESS_SECRET
  JWT_REFRESH_SECRET: REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
